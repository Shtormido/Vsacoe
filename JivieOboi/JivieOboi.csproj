<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK-проекции нужны для API экрана блокировки (Windows.System.UserProfile.LockScreen) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>JivieOboi</AssemblyName>
    <RootNamespace>JivieOboi</RootNamespace>
    <StartupObject>JivieOboi.Program</StartupObject>
    <Product>Живые обои</Product>
    <Version>1.0.0</Version>
    <!-- DPI задаётся в app.manifest, т.к. основной UI — WPF -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>

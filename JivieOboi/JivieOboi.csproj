<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10: тема Fluent для WPF; Windows SDK-проекции — для экрана блокировки и цветов Windows -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>JivieOboi</AssemblyName>
    <RootNamespace>JivieOboi</RootNamespace>
    <StartupObject>JivieOboi.Program</StartupObject>
    <Product>Живые обои</Product>
    <Version>2.0.0</Version>
    <!-- DPI задаётся в app.manifest, т.к. основной UI — WPF -->
    <!-- WPF0001: тема Fluent (Windows 11) в WPF помечена как экспериментальная -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003;WPF0001</NoWarn>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Веб-обои и видео через движок Chromium (WebView2 встроен в Windows 11) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Захват системного звука для обоев, реагирующих на музыку -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>

<Window x:Class="Vsacoe.Views.InputDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Topmost="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" />
        <TextBox x:Name="Input" Padding="4" />
        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" Margin="0,0,8,0" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Width="90" Content="Отмена" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

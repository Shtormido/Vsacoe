<Window x:Class="Vsacoe.Views.FenceWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Vsacoe Fence"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        MinWidth="120"
        MinHeight="30"
        AllowDrop="True">
    <Window.Resources>
        <!-- Почти прозрачный фон: у полностью прозрачных пикселей многослойное окно пропускает щелчки насквозь. -->
        <SolidColorBrush x:Key="HitBrush" Color="#01000000" />
        <sys:Double x:Key="IconSize">48</sys:Double>
        <sys:Double x:Key="TileWidth">88</sys:Double>

        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource HitBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDFFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#66FFFFFF" CornerRadius="3" Margin="0,2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Frame"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                Background="#99202020">
            <DockPanel LastChildFill="True">
                <Grid x:Name="TitleBar"
                      DockPanel.Dock="Top"
                      Height="28"
                      Background="#26000000"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton"
                            Style="{StaticResource TitleButton}"
                            Content="‹"
                            ToolTip="Назад"
                            Visibility="Collapsed"
                            Click="BackButton_Click" />
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Margin="6,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEditor"
                             Grid.Column="1"
                             Margin="6,3"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Visibility="Collapsed"
                             Background="#CC000000"
                             Foreground="White"
                             CaretBrush="White"
                             BorderThickness="0"
                             KeyDown="TitleEditor_KeyDown"
                             LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
                    <TextBlock x:Name="RollIndicator"
                               Grid.Column="2"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#AAFFFFFF"
                               FontSize="11" />
                </Grid>

                <Grid x:Name="ContentArea">
                    <ScrollViewer x:Name="Scroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,4,2,4">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="ItemsHost" Background="Transparent" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tile"
                                            Width="{DynamicResource TileWidth}"
                                            Margin="2"
                                            Padding="4,6,4,4"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Background="Transparent"
                                            ToolTip="{Binding Name}">
                                        <StackPanel>
                                            <Image Source="{Binding Icon}"
                                                   Width="{DynamicResource IconSize}"
                                                   Height="{DynamicResource IconSize}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="0,4,0,0"
                                                       MaxHeight="32"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center"
                                                       Foreground="White"
                                                       FontSize="12">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="#26FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="#4D9CC8FF" />
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="#999CC8FF" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#99FFFFFF"
                               FontSize="12"
                               IsHitTestVisible="False"
                               Text="Перетащите сюда файлы, папки или ярлыки" />

                    <Border x:Name="InsertMarker"
                            Width="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FF9CC8FF"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Ручки изменения размера по краям и углам -->
        <Thumb x:Name="ThumbLeft" Style="{StaticResource EdgeThumb}" Width="5" HorizontalAlignment="Left" Margin="0,8" Cursor="SizeWE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbRight" Style="{StaticResource EdgeThumb}" Width="5" HorizontalAlignment="Right" Margin="0,8" Cursor="SizeWE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbTop" Style="{StaticResource EdgeThumb}" Height="4" VerticalAlignment="Top" Margin="8,0" Cursor="SizeNS" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbBottom" Style="{StaticResource EdgeThumb}" Height="5" VerticalAlignment="Bottom" Margin="8,0" Cursor="SizeNS" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbTopLeft" Style="{StaticResource EdgeThumb}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbTopRight" Style="{StaticResource EdgeThumb}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbBottomLeft" Style="{StaticResource EdgeThumb}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ThumbBottomRight" Style="{StaticResource EdgeThumb}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    </Grid>
</Window>

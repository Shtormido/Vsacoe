{
  "name": "pushistik-groomer",
  "productName": "Пушистый салон",
  "version": "1.0.0",
  "description": "3D симулятор грумера: свой салон, инструменты, сюжет и постоянные клиенты",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "models": "python3 blender/build_all.py",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "vite build && electron-builder --linux AppImage --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.1.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "ru.pushistik.groomer",
    "productName": "Пушистый салон",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
